    <record id="collection_sheet_company_rule" model="ir.rule">
        <field name="name">Collection Sheet: multi-company</field>
        <field name="model_id" ref="model_collection_sheet" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="collection_voucher_review_snapshot_company_rule" model="ir.rule">
        <field name="name">Collection Review Snapshot: multi-company</field>
        <field name="model_id" ref="model_collection_voucher_review_snapshot" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
