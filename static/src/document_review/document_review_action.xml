<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="collection.DocumentReviewAction">
        <div class="o_collection_doc_review">
            <div class="shell">
                <div t-if="state.loading &amp;&amp; !hasQueue" class="clay empty-state">
                    <p>Cargando cola de revisión…</p>
                </div>
                <div t-elif="!hasQueue" class="clay empty-state">
                    <h2>No hay comprobantes pendientes</h2>
                    <p>No quedan comprobantes elegibles para revisar.</p>
                </div>
                <main t-else="" class="split">
                    <section class="clay viewer" aria-label="Visor del documento">
                        <div t-if="viewerIsReady" class="viewer-toolbar">
                            <button
                class="clay blob-btn"
                type="button"
                aria-label="Rotar a la izquierda"
                t-on-click="rotateViewerLeft"
              >
                                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                                    <path
                    d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                  />
                                    <path d="M3 3v5h5" />
                                </svg>
                            </button>
                            <button
                class="clay blob-btn"
                type="button"
                aria-label="Rotar a la derecha"
                t-on-click="rotateViewerRight"
              >
                                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                                    <path
                    d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"
                  />
                                    <path d="M21 3v5h-5" />
                                </svg>
                            </button>
                            <button
                class="clay blob-btn"
                type="button"
                aria-label="Ajustar al visor"
                t-on-click="fitViewer"
              >
                                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                                    <path d="M15 3h6v6" />
                                    <path d="M9 21H3v-6" />
                                    <path d="M21 3l-7 7" />
                                    <path d="M3 21l7-7" />
                                </svg>
                            </button>
                        </div>
                        <div
              t-attf-class="press tray {{ viewerCanPan ? 'is-zoom-pannable' : '' }} {{ state.viewerPanning ? 'is-panning' : '' }}"
              t-on-wheel.prevent="onViewerWheel"
              t-on-pointerdown="onViewerPointerDown"
              t-on-pointermove="onViewerPointerMove"
              t-on-pointerup="onViewerPointerUp"
              t-on-pointercancel="onViewerPointerUp"
              t-on-lostpointercapture="onViewerPointerUp"
            >
                            <p t-if="viewerIsEmpty" class="viewer-empty">
                                No hay archivo adjunto para mostrar.
                            </p>
                            <t t-else="">
                                <p
                  t-if="state.viewerStatus === 'loading'"
                  class="viewer-loading"
                >
                                    Cargando documento…
                                </p>
                                <p
                  t-if="state.viewerStatus === 'error'"
                  class="viewer-error"
                >
                                    No se pudo cargar el documento.
                                </p>
                                <div class="viewer-zoom" t-att-style="viewerZoomStyle">
                                    <div
                    t-attf-class="viewer-rotate {{ viewerRotateIsOdd ? 'is-odd' : '' }}"
                    t-att-style="viewerRotateStyle"
                  >
                                        <img
                      t-if="viewerIsImage"
                      t-attf-class="viewer-image {{ state.viewerStatus === 'ready' ? '' : 'is-hidden' }} {{ state.viewerFit ? 'is-fitted' : '' }}"
                      t-att-src="current.attachment_url"
                      t-att-alt="current.attachment_filename"
                      draggable="false"
                      t-on-load="onViewerLoad"
                      t-on-error="onViewerError"
                    />
                                        <iframe
                      t-if="viewerIsPdf"
                      t-attf-class="viewer-pdf {{ state.viewerStatus === 'ready' ? '' : 'is-hidden' }}"
                      t-attf-src="{{current.attachment_url}}{{pdfFitFragment}}"
                      title="Comprobante PDF"
                      t-on-load="onViewerLoad"
                      t-on-error="onViewerError"
                    />
                                    </div>
                                </div>
                                <div t-if="viewerIsPdf" class="viewer-pdf-hitbox" />
                            </t>
                        </div>
                    </section>

                    <section class="clay panel" aria-label="Validación de campos">
                        <div class="phead">
                            <h2>Validá los campos</h2>
                            <div class="corner">
                                <p class="doc-id" t-out="current.voucher_name" />
                                <div class="nav">
                                    <button
                    class="clay blob-btn"
                    type="button"
                    aria-label="Documento anterior"
                    t-att-disabled="!canPrev || state.busy"
                    t-on-click="goPrev"
                  >
                                        <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                                            <path d="M15 18l-6-6 6-6" />
                                        </svg>
                                    </button>
                                    <span class="count">
                                        <b t-out="current.position" />
                                        /
                                        <t t-out="current.total" />
                                    </span>
                                    <button
                    class="clay blob-btn"
                    type="button"
                    aria-label="Documento siguiente"
                    t-att-disabled="!canNext || state.busy"
                    t-on-click="goNext"
                  >
                                        <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                                            <path d="M9 18l6-6-6-6" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="panel-body">
                            <div class="field">
                                <div class="ftop">
                                    <label for="collection_review_document_type">
                                        Tipo de documento
                                    </label>
                                </div>
                                <div class="slot">
                                    <input
                    id="collection_review_document_type"
                    type="text"
                    readonly="readonly"
                    tabindex="-1"
                    aria-label="OCR Tipo de documento"
                    t-att-value="current.ocr_document_type"
                  />
                                </div>
                                <p
                  class="seller-warning"
                  role="status"
                  aria-live="polite"
                  t-if="hasSellerChangedField(current.seller_changed_fields, 'document_type')"
                  t-out="formatSellerChangedValue(current.seller_changed_fields, 'document_type')"
                />
                            </div>

                            <div class="field">
                                <div class="ftop">
                                    <label for="collection_review_amount">Monto</label>
                                </div>
                                <div class="slot">
                                    <input
                    id="collection_review_amount"
                    type="number"
                    step="0.01"
                    readonly="readonly"
                    tabindex="-1"
                    aria-label="OCR Monto"
                    t-att-value="current.ocr_amount"
                  />
                                </div>
                                <p
                  class="seller-warning"
                  role="status"
                  aria-live="polite"
                  t-if="hasSellerChangedField(current.seller_changed_fields, 'amount')"
                  t-out="formatSellerChangedValue(current.seller_changed_fields, 'amount')"
                />
                            </div>

                            <t t-if="isBankTransfer">
                                <div class="field">
                                    <div class="ftop">
                                        <label for="collection_review_from_account">
                                            Cuenta origen
                                        </label>
                                    </div>
                                    <div class="slot">
                                        <input
                      id="collection_review_from_account"
                      type="text"
                      readonly="readonly"
                      tabindex="-1"
                      aria-label="OCR Cuenta origen"
                      t-att-value="current.ocr_from_account"
                    />
                                    </div>
                                    <p
                    class="seller-warning"
                    role="status"
                    aria-live="polite"
                    t-if="hasSellerChangedField(current.seller_changed_fields, 'from_account')"
                    t-out="formatSellerChangedValue(current.seller_changed_fields, 'from_account')"
                  />
                                </div>
                                <div class="field">
                                    <div class="ftop">
                                        <label for="collection_review_to_account">
                                            Cuenta destino
                                        </label>
                                    </div>
                                    <div class="slot">
                                        <input
                      id="collection_review_to_account"
                      type="text"
                      readonly="readonly"
                      tabindex="-1"
                      aria-label="OCR Cuenta destino"
                      t-att-value="current.ocr_to_account"
                    />
                                    </div>
                                    <p
                    class="seller-warning"
                    role="status"
                    aria-live="polite"
                    t-if="hasSellerChangedField(current.seller_changed_fields, 'to_account')"
                    t-out="formatSellerChangedValue(current.seller_changed_fields, 'to_account')"
                  />
                                </div>
                                <div class="row">
                                    <div class="field">
                                        <div class="ftop">
                                            <label
                        for="collection_review_voucher_number"
                      >
                                                Nro. comprobante
                                            </label>
                                        </div>
                                        <div class="slot">
                                            <input
                        id="collection_review_voucher_number"
                        type="text"
                        readonly="readonly"
                        tabindex="-1"
                        aria-label="OCR Nro. comprobante"
                        t-att-value="current.ocr_voucher_number"
                      />
                                        </div>
                                        <p
                      class="seller-warning"
                      role="status"
                      aria-live="polite"
                      t-if="hasSellerChangedField(current.seller_changed_fields, 'voucher_number')"
                      t-out="formatSellerChangedValue(current.seller_changed_fields, 'voucher_number')"
                    />
                                    </div>
                                    <div class="field">
                                        <div class="ftop">
                                            <label for="collection_review_voucher_date">
                                                Fecha
                                            </label>
                                        </div>
                                        <div class="slot">
                                            <input
                        id="collection_review_voucher_date"
                        type="date"
                        readonly="readonly"
                        tabindex="-1"
                        aria-label="OCR Fecha"
                        t-att-value="current.ocr_voucher_date"
                      />
                                        </div>
                                        <p
                      class="seller-warning"
                      role="status"
                      aria-live="polite"
                      t-if="hasSellerChangedField(current.seller_changed_fields, 'voucher_date')"
                      t-out="formatSellerChangedValue(current.seller_changed_fields, 'voucher_date')"
                    />
                                    </div>
                                </div>
                            </t>

                            <t t-if="isCheck">
                                <div class="field">
                                    <div class="ftop">
                                        <label for="collection_review_check_number">
                                            Nro. cheque
                                        </label>
                                    </div>
                                    <div class="slot">
                                        <input
                      id="collection_review_check_number"
                      type="text"
                      readonly="readonly"
                      tabindex="-1"
                      aria-label="OCR Nro. cheque"
                      t-att-value="current.ocr_check_number"
                    />
                                    </div>
                                    <p
                    class="seller-warning"
                    role="status"
                    aria-live="polite"
                    t-if="hasSellerChangedField(current.seller_changed_fields, 'check_number')"
                    t-out="formatSellerChangedValue(current.seller_changed_fields, 'check_number')"
                  />
                                </div>
                                <div class="field">
                                    <div class="ftop">
                                        <label for="collection_review_check_bank">
                                            Banco
                                        </label>
                                    </div>
                                    <div class="slot">
                                        <input
                      id="collection_review_check_bank"
                      type="text"
                      readonly="readonly"
                      tabindex="-1"
                      aria-label="OCR Banco"
                      t-att-value="current.ocr_check_bank"
                    />
                                    </div>
                                    <p
                    class="seller-warning"
                    role="status"
                    aria-live="polite"
                    t-if="hasSellerChangedField(current.seller_changed_fields, 'check_bank')"
                    t-out="formatSellerChangedValue(current.seller_changed_fields, 'check_bank')"
                  />
                                </div>
                                <div class="field">
                                    <div class="ftop">
                                        <label for="collection_review_check_type">
                                            Tipo de cheque
                                        </label>
                                    </div>
                                    <div class="slot">
                                        <input
                      id="collection_review_check_type"
                      type="text"
                      readonly="readonly"
                      tabindex="-1"
                      aria-label="OCR Tipo de cheque"
                      t-att-value="current.ocr_check_type"
                    />
                                    </div>
                                    <p
                    class="seller-warning"
                    role="status"
                    aria-live="polite"
                    t-if="hasSellerChangedField(current.seller_changed_fields, 'check_type')"
                    t-out="formatSellerChangedValue(current.seller_changed_fields, 'check_type')"
                  />
                                </div>
                                <div class="row">
                                    <div class="field">
                                        <div class="ftop">
                                            <label
                        for="collection_review_check_issue_date"
                      >
                                                Fecha de emisión
                                            </label>
                                        </div>
                                        <div class="slot">
                                            <input
                        id="collection_review_check_issue_date"
                        type="date"
                        readonly="readonly"
                        tabindex="-1"
                        aria-label="OCR Fecha de emisión"
                        t-att-value="current.ocr_check_issue_date"
                      />
                                        </div>
                                        <p
                      class="seller-warning"
                      role="status"
                      aria-live="polite"
                      t-if="hasSellerChangedField(current.seller_changed_fields, 'check_issue_date')"
                      t-out="formatSellerChangedValue(current.seller_changed_fields, 'check_issue_date')"
                    />
                                    </div>
                                    <div class="field">
                                        <div class="ftop">
                                            <label
                        for="collection_review_check_payment_date"
                      >
                                                Fecha de pago
                                            </label>
                                        </div>
                                        <div class="slot">
                                            <input
                        id="collection_review_check_payment_date"
                        type="date"
                        readonly="readonly"
                        tabindex="-1"
                        aria-label="OCR Fecha de pago"
                        t-att-value="current.ocr_check_payment_date"
                      />
                                        </div>
                                        <p
                      class="seller-warning"
                      role="status"
                      aria-live="polite"
                      t-if="hasSellerChangedField(current.seller_changed_fields, 'check_payment_date')"
                      t-out="formatSellerChangedValue(current.seller_changed_fields, 'check_payment_date')"
                    />
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="acts">
                            <button
                class="btn yes"
                type="button"
                t-att-disabled="state.busy"
                t-on-click="approve"
              >
                                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                                    <path d="M20 6L9 17l-5-5" />
                                </svg>
                                Aprobar y seguir
                            </button>
                        </div>
                    </section>
                </main>
            </div>
        </div>
    </t>
</templates>
