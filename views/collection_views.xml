<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Drop leftover header+line records on in-place -u; no-op on fresh install. -->
    <delete
    model="ir.model.access"
    search="[('name', '=', 'collection.voucher.line.user')]"
  />
    <delete model="ir.ui.menu" search="[('name', '=', 'Payment Lines')]" />
    <delete
    model="ir.actions.act_window"
    search="[('res_model', '=', 'collection.voucher.line')]"
  />
    <delete model="ir.ui.view" search="[('model', '=', 'collection.voucher.line')]" />
    <delete
    model="ir.ui.view"
    search="[('name', '=', 'collection.voucher.kanban'), ('model', '=', 'collection.voucher')]"
  />

    <!-- List -->
    <record id="view_collection_voucher_list" model="ir.ui.view">
        <field name="name">collection.voucher.list</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <list string="Payment Vouchers">
                <field name="name" />
                <field name="create_date" readonly="1" />
                <field name="sheet_id" />
                <field
          name="seller_id"
          domain="[('id', 'in', company_id.enabled_seller_ids)]"
        />
                <field name="document_type" />
                <field name="amount" />
                <field name="state" />
                <field name="partner_id" optional="hide" />
                <field name="company_id" optional="hide" />
                <field name="document_id" optional="hide" />
                <field name="reviewed_by" optional="hide" />
                <field name="reviewed_at" optional="hide" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_collection_voucher_search" model="ir.ui.view">
        <field name="name">collection.voucher.search</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Payment Vouchers">
                <field name="name" />
                <field name="partner_id" />
                <field name="seller_id" />
                <field name="sheet_id" />
                <field name="create_date" />
                <field name="state" />
                <field name="document_type" />
                <field name="amount" />
                <filter
          string="Draft"
          name="filter_draft"
          domain="[('state', '=', 'draft')]"
        />
                <filter
          string="Validated by Seller"
          name="filter_validated_seller"
          domain="[('state', '=', 'validated_seller')]"
        />
                <filter
          string="Validated by Collections"
          name="filter_validated_collections"
          domain="[('state', '=', 'validated_collections')]"
        />
                <separator />
                <filter
          string="Bank Transfer"
          name="filter_bank_transfer"
          domain="[('document_type', '=', 'bank_transfer')]"
        />
                <filter
          string="Check"
          name="filter_check"
          domain="[('document_type', '=', 'check')]"
        />
                <filter
          string="Cash Deposit"
          name="filter_cash_deposit"
          domain="[('document_type', '=', 'cash_deposit')]"
        />
                <filter
          string="Unsupported"
          name="filter_unsupported"
          domain="[('document_type', '=', 'unsupported')]"
        />
                <separator />
                <filter
          string="Created On"
          name="filter_create_date"
          date="create_date"
        />
                <group>
                    <filter
            string="Status"
            name="group_state"
            context="{'group_by': 'state'}"
          />
                    <filter
            string="Created On"
            name="group_create_date"
            context="{'group_by': 'create_date'}"
          />
                    <filter
            string="Document Type"
            name="group_document_type"
            context="{'group_by': 'document_type'}"
          />
                    <filter
            string="Sheet"
            name="group_sheet_id"
            context="{'group_by': 'sheet_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="view_collection_voucher_reassign_kanban" model="ir.ui.view">
        <field name="name">collection.voucher.reassign.kanban</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <kanban
        string="Reassign Customers"
        default_group_by="partner_id"
        records_draggable="1"
        create="0"
        quick_create="0"
        group_create="0"
        group_delete="0"
        group_edit="0"
        groups_draggable="0"
        class="o_kanban_mobile"
      >
                <field name="name" />
                <field name="partner_id" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-2">
                            <field name="name" class="fw-bolder fs-5" />
                        </div>
                        <field name="partner_id" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_collection_voucher_form" model="ir.ui.view">
        <field name="name">collection.voucher.form</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher">
                <header>
                    <button
            name="action_validate_seller"
            string="Validate by Seller"
            type="object"
            class="oe_highlight"
            invisible="state != 'draft'"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="draft,validated_seller,validated_collections"
            options="{'clickable': False}"
          />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="company_id" invisible="1" />
                            <field
                name="seller_id"
                required="1"
                domain="[('id', 'in', company_id.enabled_seller_ids)]"
              />
                            <field name="sheet_id" />
                            <field name="create_date" readonly="1" />
                        </group>
                        <group>
                            <field name="currency_id" groups="base.group_no_one" />
                            <field name="reviewed_by" readonly="1" />
                            <field name="reviewed_at" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Current">
                            <group string="Payment">
                                <field name="document_type" />
                                <field name="document_id" />
                                <field
                  name="amount"
                  invisible="document_type == 'unsupported'"
                />
                                <field
                  name="from_account"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="to_account"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="voucher_number"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="voucher_date"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="check_number"
                  invisible="document_type != 'check'"
                />
                                <field
                  name="check_bank"
                  invisible="document_type != 'check'"
                />
                                <field
                  name="check_type"
                  invisible="document_type != 'check'"
                />
                                <field
                  name="check_issue_date"
                  invisible="document_type != 'check'"
                />
                                <field
                  name="check_payment_date"
                  invisible="document_type != 'check'"
                />
                            </group>
                        </page>
                        <page string="Raw OCR">
                            <group string="Payment">
                                <field name="ocr_document_type" readonly="1" />
                                <field
                  name="ocr_amount"
                  readonly="1"
                  invisible="ocr_document_type == 'unsupported' and document_type == 'unsupported'"
                />
                                <field
                  name="ocr_from_account"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_to_account"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_voucher_number"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_voucher_date"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_check_number"
                  readonly="1"
                  invisible="ocr_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="ocr_check_bank"
                  readonly="1"
                  invisible="ocr_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="ocr_check_type"
                  readonly="1"
                  invisible="ocr_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="ocr_check_issue_date"
                  readonly="1"
                  invisible="ocr_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="ocr_check_payment_date"
                  readonly="1"
                  invisible="ocr_document_type != 'check' and document_type != 'check'"
                />
                            </group>
                        </page>
                        <page string="Seller Confirmed">
                            <group string="Payment">
                                <field name="seller_document_type" readonly="1" />
                                <field
                  name="seller_amount"
                  readonly="1"
                  invisible="seller_document_type == 'unsupported' and document_type == 'unsupported'"
                />
                                <field
                  name="seller_from_account"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_to_account"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_voucher_number"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_voucher_date"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_check_number"
                  readonly="1"
                  invisible="seller_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="seller_check_bank"
                  readonly="1"
                  invisible="seller_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="seller_check_type"
                  readonly="1"
                  invisible="seller_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="seller_check_issue_date"
                  readonly="1"
                  invisible="seller_document_type != 'check' and document_type != 'check'"
                />
                                <field
                  name="seller_check_payment_date"
                  readonly="1"
                  invisible="seller_document_type != 'check' and document_type != 'check'"
                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" reload_on_attachment="True" />
            </form>
        </field>
    </record>

    <!-- List-bound Action: create a collection sheet from selected vouchers -->
    <record id="action_create_collection_sheet" model="ir.actions.server">
        <field name="name">Create Collection Sheet</field>
        <field name="model_id" ref="model_collection_voucher" />
        <field name="binding_model_id" ref="model_collection_voucher" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_collection_sheet()</field>
    </record>

    <!-- Action -->
    <record id="action_collection_voucher" model="ir.actions.act_window">
        <field name="name">Payment Vouchers</field>
        <field name="res_model">collection.voucher</field>
        <field name="path">payment-vouchers</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_voucher_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a payment voucher
            </p>
        </field>
    </record>

    <!-- Menus: Collections → Payment Vouchers -->
    <menuitem id="menu_collection_root" name="Collections" sequence="45" />
    <menuitem
    id="menu_collection_voucher"
    name="Payment Vouchers"
    parent="menu_collection_root"
    action="action_collection_voucher"
    sequence="10"
  />

    <!-- Collection Sheets -->
    <record id="view_collection_sheet_list" model="ir.ui.view">
        <field name="name">collection.sheet.list</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <list string="Collection Sheets">
                <field name="name" />
                <field
          name="seller_id"
          domain="[('id', 'in', company_id.enabled_seller_ids)]"
        />
                <field name="company_id" optional="hide" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_collection_sheet_search" model="ir.ui.view">
        <field name="name">collection.sheet.search</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Collection Sheets">
                <field name="name" />
                <field name="seller_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </search>
        </field>
    </record>

    <record id="view_collection_sheet_form" model="ir.ui.view">
        <field name="name">collection.sheet.form</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <form string="Collection Sheet">
                <header>
                    <button
            name="action_close"
            string="Close"
            type="object"
            class="oe_highlight"
            invisible="state != 'open'"
          />
                    <button
            name="action_reopen"
            string="Reopen"
            type="object"
            invisible="state != 'closed'"
          />
                    <button
            name="action_open_document_review"
            string="Document Review"
            type="object"
            class="oe_highlight"
            invisible="not id or not document_review_enabled"
          />
                    <button
            name="action_open_voucher_reassign"
            string="Reassign Customers"
            type="object"
            invisible="not id or state != 'open'"
          />
                    <button
            name="action_print_xlsx"
            string="Export XLSX"
            type="object"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="open,closed"
            options="{'clickable': False}"
          />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="action_open_vouchers"
              type="object"
              class="oe_stat_button"
              icon="fa-list"
              invisible="not id"
            >
                            <field
                name="voucher_count"
                widget="statinfo"
                string="Vouchers"
              />
                        </button>
                    </div>
                    <field name="document_review_enabled" invisible="1" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field
                name="seller_id"
                required="1"
                readonly="id"
                domain="[('id', 'in', company_id.enabled_seller_ids)]"
              />
                            <field name="date_from" readonly="1" />
                            <field name="date_to" readonly="1" />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="commission_percent" />
                            <field name="cash_on_hand" />
                            <field name="commission_withheld" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations">
                            <field name="allocation_ids">
                                <list create="false" delete="false">
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="state" />
                                    <field name="total_vouchers" />
                                    <field name="total_applied" />
                                    <field name="residual" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_collection_sheet" model="ir.actions.act_window">
        <field name="name">Collection Sheets</field>
        <field name="res_model">collection.sheet</field>
        <field name="path">collection-sheets</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_sheet_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a collection sheet
            </p>
        </field>
    </record>

    <menuitem
    id="menu_collection_sheet"
    name="Collection Sheets"
    parent="menu_collection_root"
    action="action_collection_sheet"
    sequence="20"
  />
</odoo>
