<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List -->
    <record id="view_collection_voucher_list" model="ir.ui.view">
        <field name="name">collection.voucher.list</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <list string="Payment Vouchers">
                <field name="name" />
                <field name="create_date" readonly="1" />
                <field name="sheet_id" />
                <field
          name="seller_id"
          domain="[('id', 'in', company_id.enabled_seller_ids)]"
        />
                <field name="document_type" />
                <field name="amount" />
                <field name="state" />
                <field name="partner_id" optional="hide" />
                <field name="company_id" optional="hide" />
                <field name="document_id" optional="hide" />
                <field name="reviewed_by" optional="hide" />
                <field name="reviewed_at" optional="hide" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_collection_voucher_search" model="ir.ui.view">
        <field name="name">collection.voucher.search</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Payment Vouchers">
                <field name="name" />
                <field name="partner_id" />
                <field name="seller_id" />
                <field name="sheet_id" />
                <field name="create_date" />
                <field name="state" />
                <field name="document_type" />
                <field name="amount" />
                <filter
          string="Draft"
          name="filter_draft"
          domain="[('state', '=', 'draft')]"
        />
                <filter
          string="Validated by Seller"
          name="filter_validated_seller"
          domain="[('state', '=', 'validated_seller')]"
        />
                <filter
          string="Validated by Collections"
          name="filter_validated_collections"
          domain="[('state', '=', 'validated_collections')]"
        />
                <separator />
                <filter
          string="Bank Transfer"
          name="filter_bank_transfer"
          domain="[('document_type', '=', 'bank_transfer')]"
        />
                <filter
          string="Check"
          name="filter_check"
          domain="[('document_type', '=', 'check')]"
        />
                <filter
          string="Cash Deposit"
          name="filter_cash_deposit"
          domain="[('document_type', '=', 'cash_deposit')]"
        />
                <filter
          string="Seller Deposit"
          name="filter_seller_deposit"
          domain="[('document_type', '=', 'seller_deposit')]"
        />
                <separator />
                <filter
          string="Created On"
          name="filter_create_date"
          date="create_date"
        />
                <group>
                    <filter
            string="Status"
            name="group_state"
            context="{'group_by': 'state'}"
          />
                    <filter
            string="Created On"
            name="group_create_date"
            context="{'group_by': 'create_date'}"
          />
                    <filter
            string="Document Type"
            name="group_document_type"
            context="{'group_by': 'document_type'}"
          />
                    <filter
            string="Sheet"
            name="group_sheet_id"
            context="{'group_by': 'sheet_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="view_collection_voucher_form" model="ir.ui.view">
        <field name="name">collection.voucher.form</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher">
                <header>
                    <button
            name="action_validate_seller"
            string="Validate by Seller"
            type="object"
            class="oe_highlight"
            invisible="state != 'draft'"
          />
                    <button
            name="action_back_to_draft"
            string="Back to Draft"
            type="object"
            invisible="state == 'draft'"
            groups="collection.group_collection_user"
            confirm="Send this voucher back to draft? A deposit or commission gives back the cash it replaced."
          />
                    <button
            name="action_remove_from_sheet"
            string="Remove from Sheet"
            type="object"
            invisible="not sheet_id or sheet_state not in ('open', 'submitted')"
            groups="collection.group_collection_user"
            confirm="Remove this voucher from its sheet and allocation? It stops paying the customer's documents; lower the allocation's applied amounts if needed."
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="draft,validated_seller,validated_collections"
            options="{'clickable': False}"
          />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                name="partner_id"
                readonly="state == 'validated_collections'"
              />
                            <field name="company_id" invisible="1" />
                            <field
                name="seller_id"
                required="1"
                domain="[('id', 'in', company_id.enabled_seller_ids)]"
              />
                            <field name="sheet_id" />
                            <field name="sheet_state" invisible="1" />
                            <field name="create_date" readonly="1" />
                        </group>
                        <group>
                            <field
                name="currency_id"
                groups="base.group_no_one"
                readonly="state == 'validated_collections'"
              />
                            <field name="reviewed_by" readonly="1" />
                            <field name="reviewed_at" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Current">
                            <group string="Payment">
                                <field
                  name="document_type"
                  readonly="state == 'validated_collections'"
                />
                                <field name="document_id" />
                                <field
                  name="amount"
                  readonly="state == 'validated_collections'"
                />
                                <field
                  name="from_account"
                  readonly="state == 'validated_collections'"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="to_account"
                  readonly="state == 'validated_collections'"
                  invisible="document_type != 'bank_transfer'"
                />
                                <field
                  name="to_account_bank_id"
                  readonly="state == 'validated_collections'"
                  domain="[('partner_id', '=', company_partner_id)]"
                  invisible="document_type not in ('bank_transfer', 'cash_deposit')"
                />
                                <field
                  name="to_account_mismatch"
                  readonly="1"
                  invisible="not to_account_mismatch"
                />
                                <field
                  name="voucher_number"
                  readonly="state == 'validated_collections'"
                  invisible="document_type != 'bank_transfer' and document_type != 'seller_deposit'"
                />
                                <field
                  name="voucher_date"
                  readonly="state == 'validated_collections'"
                  invisible="document_type != 'bank_transfer' and document_type != 'seller_deposit'"
                />
                                <field
                  name="check_number"
                  readonly="state == 'validated_collections'"
                  invisible="document_type not in ('check', 'echeck')"
                  required="document_type in ('check', 'echeck')"
                />
                                <field
                  name="check_bank"
                  readonly="state == 'validated_collections'"
                  invisible="document_type not in ('check', 'echeck')"
                />
                                <field
                  name="check_type"
                  readonly="state == 'validated_collections'"
                  invisible="document_type not in ('check', 'echeck')"
                />
                                <field
                  name="check_issue_date"
                  readonly="state == 'validated_collections'"
                  invisible="document_type not in ('check', 'echeck')"
                />
                                <field
                  name="check_payment_date"
                  readonly="state == 'validated_collections'"
                  invisible="document_type not in ('check', 'echeck')"
                />
                            </group>
                        </page>
                        <page string="Raw OCR">
                            <group string="Payment">
                                <field name="ocr_document_type" readonly="1" />
                                <field name="ocr_amount" readonly="1" />
                                <field
                  name="ocr_from_account"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_to_account"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="ocr_voucher_number"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer' and ocr_document_type != 'seller_deposit' and document_type != 'seller_deposit'"
                />
                                <field
                  name="ocr_voucher_date"
                  readonly="1"
                  invisible="ocr_document_type != 'bank_transfer' and document_type != 'bank_transfer' and ocr_document_type != 'seller_deposit' and document_type != 'seller_deposit'"
                />
                                <field
                  name="ocr_check_number"
                  readonly="1"
                  invisible="ocr_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="ocr_check_bank"
                  readonly="1"
                  invisible="ocr_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="ocr_check_type"
                  readonly="1"
                  invisible="ocr_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="ocr_check_issue_date"
                  readonly="1"
                  invisible="ocr_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="ocr_check_payment_date"
                  readonly="1"
                  invisible="ocr_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                            </group>
                        </page>
                        <page string="Seller Confirmed">
                            <group string="Payment">
                                <field name="seller_document_type" readonly="1" />
                                <field name="seller_amount" readonly="1" />
                                <field
                  name="seller_from_account"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_to_account"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer'"
                />
                                <field
                  name="seller_voucher_number"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer' and seller_document_type != 'seller_deposit' and document_type != 'seller_deposit'"
                />
                                <field
                  name="seller_voucher_date"
                  readonly="1"
                  invisible="seller_document_type != 'bank_transfer' and document_type != 'bank_transfer' and seller_document_type != 'seller_deposit' and document_type != 'seller_deposit'"
                />
                                <field
                  name="seller_check_number"
                  readonly="1"
                  invisible="seller_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="seller_check_bank"
                  readonly="1"
                  invisible="seller_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="seller_check_type"
                  readonly="1"
                  invisible="seller_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="seller_check_issue_date"
                  readonly="1"
                  invisible="seller_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                                <field
                  name="seller_check_payment_date"
                  readonly="1"
                  invisible="seller_document_type not in ('check', 'echeck') and document_type not in ('check', 'echeck')"
                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" reload_on_attachment="True" />
            </form>
        </field>
    </record>

    <!-- List-bound Action: create a collection sheet from selected vouchers -->
    <record id="action_create_collection_sheet" model="ir.actions.server">
        <field name="name">Create Collection Sheet</field>
        <field name="model_id" ref="model_collection_voucher" />
        <field name="binding_model_id" ref="model_collection_voucher" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_collection_sheet()</field>
    </record>

    <!-- Action -->
    <record id="action_collection_voucher" model="ir.actions.act_window">
        <field name="name">Payment Vouchers</field>
        <field name="res_model">collection.voucher</field>
        <field name="path">collection-vouchers</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_voucher_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a payment voucher
            </p>
        </field>
    </record>

    <!-- Menus: Collections → Payment Vouchers -->
    <!-- Administrators reach Configuration even without a collection role. -->
    <menuitem
    id="menu_collection_root"
    name="Collections"
    sequence="45"
    groups="collection.group_collection_user,base.group_system"
  />
    <menuitem
    id="menu_collection_voucher"
    name="Payment Vouchers"
    parent="menu_collection_root"
    action="action_collection_voucher"
    sequence="10"
    groups="collection.group_collection_user"
  />

    <!-- Collection Sheets -->
    <record id="view_collection_sheet_list" model="ir.ui.view">
        <field name="name">collection.sheet.list</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <list string="Collection Sheets">
                <field name="name" />
                <field
          name="seller_id"
          domain="[('id', 'in', company_id.enabled_seller_ids)]"
        />
                <field name="company_id" optional="hide" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="erp_entered_date" optional="hide" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_collection_sheet_search" model="ir.ui.view">
        <field name="name">collection.sheet.search</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Collection Sheets">
                <field name="name" />
                <field name="seller_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
                <filter
          name="pending_erp_entry"
          string="Pending ERP entry"
          domain="[('state', '=', 'closed'), ('erp_entered_date', '=', False)]"
        />
            </search>
        </field>
    </record>

    <record id="view_collection_sheet_form" model="ir.ui.view">
        <field name="name">collection.sheet.form</field>
        <field name="model">collection.sheet</field>
        <field name="arch" type="xml">
            <form string="Collection Sheet">
                <header>
                    <button
            name="action_open_seller_close"
            string="Seller Close"
            type="object"
            class="oe_highlight"
            invisible="not id or state != 'open'"
          />
                    <button
            name="action_confirm"
            string="Confirm"
            type="object"
            class="oe_highlight"
            invisible="not id or state != 'submitted'"
            groups="collection.group_collection_user"
          />
                    <button
            name="action_declare_cash"
            string="Declare Cash"
            type="object"
            invisible="not id or state != 'submitted'"
          />
                    <button
            name="action_close"
            string="Close"
            type="object"
            class="oe_highlight"
            invisible="state != 'proposal'"
            groups="collection.group_collection_user"
          />
                    <button
            name="action_cancel"
            string="Cancel"
            type="object"
            invisible="state not in ('submitted', 'proposal', 'closed') or erp_entered_date"
            groups="collection.group_collection_user"
            confirm="Cancel this sheet? Closed receipts reopen, allocations go back to draft, and the ERP mark is cleared."
          />
                    <!-- Clearing the ERP mark stays with managers. -->
                    <button
            name="action_cancel"
            string="Cancel"
            type="object"
            invisible="state not in ('submitted', 'proposal', 'closed') or not erp_entered_date"
            groups="collection.group_collection_manager"
            confirm="Cancel this sheet? Closed receipts reopen, allocations go back to draft, and the ERP mark is cleared."
          />
                    <button
            name="action_reinstate"
            string="Reinstate"
            type="object"
            invisible="state != 'cancelled'"
            groups="collection.group_collection_manager"
          />
                    <button
            name="action_reset_to_open"
            string="Reset to Open"
            type="object"
            invisible="not id or state == 'open' or erp_entered_date"
            groups="collection.group_collection_user"
            confirm="Reset this sheet to Open? The ERP mark is cleared, the seller commission is removed, and the seller must close and declare cash again."
          />
                    <button
            name="action_reset_to_open"
            string="Reset to Open"
            type="object"
            invisible="not id or state == 'open' or not erp_entered_date"
            groups="collection.group_collection_manager"
            confirm="Reset this sheet to Open? The ERP mark is cleared, the seller commission is removed, and the seller must close and declare cash again."
          />
                    <button
            name="action_mark_erp_entered"
            string="Mark as Entered in the ERP"
            type="object"
            invisible="state != 'closed' or erp_entered_date"
            groups="collection.group_collection_manager"
            confirm="Confirm that every receipt of this sheet was entered in the ERP. Its amounts stop being subtracted from the ERP balances after the next refresh."
          />
                    <button
            name="action_unmark_erp_entered"
            string="Unmark Entered in the ERP"
            type="object"
            invisible="not erp_entered_date"
            groups="collection.group_collection_manager"
            confirm="Remove the Entered in the ERP mark? The amounts of this sheet are subtracted from the ERP balances again after the next refresh."
          />
                    <button
            name="action_open_document_review"
            string="Document Review"
            type="object"
            invisible="not id or not document_review_enabled or state not in ('open', 'submitted')"
            groups="collection.group_collection_user"
          />
                    <button
            name="action_print_xlsx"
            string="Collection Sheet XLSX"
            type="object"
            invisible="not id"
            groups="collection.group_collection_user"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="open,submitted,proposal,closed,cancelled"
            options="{'clickable': False}"
          />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="action_open_vouchers"
              type="object"
              class="oe_stat_button"
              icon="fa-list"
              invisible="not id"
            >
                            <field
                name="voucher_count"
                widget="statinfo"
                string="Vouchers"
              />
                        </button>
                    </div>
                    <field name="document_review_enabled" invisible="1" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field
                name="seller_id"
                required="1"
                readonly="id"
                domain="[('id', 'in', company_id.enabled_seller_ids)]"
              />
                            <field name="date_from" readonly="1" />
                            <field name="date_to" readonly="1" />
                            <field
                name="erp_entered_date"
                readonly="1"
                invisible="state != 'closed'"
              />
                            <field
                name="erp_entered_uid"
                readonly="1"
                invisible="not erp_entered_date"
              />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field
                name="commission_percent"
                readonly="state in ('closed', 'cancelled')"
              />
                            <field name="commission_amount" />
                            <field name="cash_collected" />
                            <field name="cash_banked" />
                            <field
                name="commission_withheld"
                readonly="state != 'submitted'"
              />
                            <field name="commission_owed" />
                            <field name="cash_on_hand" readonly="1" />
                            <field name="residual_cash_value_total" invisible="1" />
                        </group>
                    </group>
                    <div
            class="alert alert-warning"
            role="alert"
            invisible="state in ('open', 'submitted') or residual_cash_value_total == 0"
          >
                        <div class="fw-bold">
                            Cash not covered by a bank deposit or commission:
                            <field name="residual_cash_value_total" readonly="1" />
                        </div>
                        <div>
                            It still pays customer receipts, so the seller hands it in
                            as physical cash. This does not block Confirm or Close.
                        </div>
                    </div>
                    <notebook>
                        <page string="Allocations">
                            <field
                name="allocation_ids"
                readonly="state not in ('open', 'submitted', 'proposal')"
              >
                                <list>
                                    <field name="name" string="Reference" />
                                    <field name="partner_id" string="Customer" />
                                    <field name="total_debt" string="Total Debt" />
                                    <field
                    name="total_vouchers"
                    string="Total Vouchers Applied"
                  />
                                    <field name="residual" string="Residual" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Vouchers">
                            <field
                name="voucher_ids"
                create="false"
                delete="false"
                readonly="state not in ('open', 'submitted')"
              >
                                <list create="false" delete="false">
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="state" />
                                    <field name="document_type" />
                                    <field name="amount" />
                                    <field name="currency_id" column_invisible="1" />
                                    <button
                    name="action_remove_from_sheet"
                    title="Remove from Sheet"
                    type="object"
                    icon="fa-trash-o"
                    column_invisible="parent.state not in ('open', 'submitted')"
                    groups="collection.group_collection_user"
                    confirm="Remove this voucher from the sheet and its allocation? It stops paying the customer's documents; lower the allocation's applied amounts if needed."
                  />
                                </list>
                            </field>
                        </page>
                        <page string="Debt">
                            <field name="debt_line_ids" create="false" delete="false">
                                <list create="false" delete="false" editable="bottom">
                                    <field name="partner_id" readonly="1" />
                                    <field name="document_kind" readonly="1" />
                                    <field name="invoice_number" readonly="1" />
                                    <field name="due_date" readonly="1" />
                                    <field name="invoice_balance" readonly="1" />
                                    <field
                    name="amount_applied"
                    readonly="parent.state not in ('open', 'submitted', 'proposal')"
                  />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_collection_sheet" model="ir.actions.act_window">
        <field name="name">Collection Sheets</field>
        <field name="res_model">collection.sheet</field>
        <field name="path">collection-sheets</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_sheet_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a collection sheet
            </p>
        </field>
    </record>

    <menuitem
    id="menu_collection_sheet"
    name="Collection Sheets"
    parent="menu_collection_root"
    action="action_collection_sheet"
    sequence="20"
    groups="collection.group_collection_user"
  />
</odoo>
