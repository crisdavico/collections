<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Drop leftover header+line records on in-place -u; no-op on fresh install. -->
    <delete
    model="ir.model.access"
    search="[('name', '=', 'collection.voucher.line.user')]"
  />
    <delete model="ir.ui.menu" search="[('name', '=', 'Payment Lines')]" />
    <delete
    model="ir.actions.act_window"
    search="[('res_model', '=', 'collection.voucher.line')]"
  />
    <delete model="ir.ui.view" search="[('model', '=', 'collection.voucher.line')]" />

    <!-- List -->
    <record id="view_collection_voucher_list" model="ir.ui.view">
        <field name="name">collection.voucher.list</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <list string="Payment Vouchers">
                <field name="name" />
                <field name="customer_identification" />
                <field name="create_date" readonly="1" />
                <field name="state" />
                <field name="reviewed_by" optional="hide" />
                <field name="reviewed_at" optional="hide" />
                <field name="document_type" />
                <field name="document_id" optional="hide" />
                <field name="amount" />
                <field name="currency_id" column_invisible="1" />
                <field
          name="attachment"
          widget="binary"
          filename="attachment_filename"
          options="{'accepted_file_extensions': 'image/*,.pdf'}"
        />
                <field name="attachment_filename" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_collection_voucher_search" model="ir.ui.view">
        <field name="name">collection.voucher.search</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Payment Vouchers">
                <field name="name" />
                <field name="customer_identification" />
                <field name="create_date" />
                <field name="state" />
                <field name="document_type" />
                <field name="amount" />
                <filter
          string="Pending"
          name="filter_pending"
          domain="[('state', '=', 'pending')]"
        />
                <filter
          string="Approved"
          name="filter_approved"
          domain="[('state', '=', 'approved')]"
        />
                <filter
          string="Rejected"
          name="filter_rejected"
          domain="[('state', '=', 'rejected')]"
        />
                <separator />
                <filter
          string="Unsupported"
          name="filter_unsupported"
          domain="[('document_type', '=', 'unsupported')]"
        />
                <group>
                    <filter
            string="Status"
            name="group_state"
            context="{'group_by': 'state'}"
          />
                    <filter
            string="Created On"
            name="group_create_date"
            context="{'group_by': 'create_date'}"
          />
                    <filter
            string="Document Type"
            name="group_document_type"
            context="{'group_by': 'document_type'}"
          />
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_collection_voucher_kanban" model="ir.ui.view">
        <field name="name">collection.voucher.kanban</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <kanban
        string="Payment Vouchers"
        default_group_by="state"
        records_draggable="1"
        class="o_kanban_mobile"
      >
                <field name="name" />
                <field name="customer_identification" />
                <field name="create_date" readonly="1" />
                <field name="state" />
                <field name="activity_ids" />
                <field name="attachment" />
                <field name="attachment_filename" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-2">
                            <field name="name" class="fw-bolder fs-5" />
                        </div>
                        <field name="customer_identification" />
                        <field
              name="attachment"
              widget="binary"
              filename="attachment_filename"
              options="{'accepted_file_extensions': 'image/*,.pdf'}"
            />
                        <footer>
                            <div class="d-flex flex-wrap gap-1 text-muted text-nowrap">
                                <field name="create_date" readonly="1" />
                                <field name="activity_ids" widget="kanban_activity" />
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_collection_voucher_form" model="ir.ui.view">
        <field name="name">collection.voucher.form</field>
        <field name="model">collection.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher">
                <header>
                    <button
            name="action_approve"
            string="Approve"
            type="object"
            class="oe_highlight"
            invisible="state != 'pending'"
          />
                    <button
            name="action_reject"
            string="Reject"
            type="object"
            invisible="state != 'pending'"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="pending,approved,rejected"
          />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_identification" />
                            <field name="create_date" readonly="1" />
                        </group>
                        <group>
                            <field name="currency_id" groups="base.group_no_one" />
                            <field
                name="attachment"
                widget="binary"
                filename="attachment_filename"
                options="{'accepted_file_extensions': 'image/*,.pdf'}"
              />
                            <field name="attachment_filename" />
                            <field name="reviewed_by" readonly="1" />
                            <field name="reviewed_at" readonly="1" />
                        </group>
                    </group>
                    <group string="Payment">
                        <field name="document_type" />
                        <field name="document_id" />
                        <field
              name="amount"
              invisible="document_type == 'unsupported'"
            />
                        <field
              name="from_account"
              invisible="document_type != 'bank_transfer'"
            />
                        <field
              name="to_account"
              invisible="document_type != 'bank_transfer'"
            />
                        <field
              name="voucher_number"
              invisible="document_type != 'bank_transfer'"
            />
                        <field
              name="voucher_date"
              invisible="document_type != 'bank_transfer'"
            />
                        <field
              name="check_number"
              invisible="document_type != 'check'"
            />
                        <field name="check_bank" invisible="document_type != 'check'" />
                        <field name="check_type" invisible="document_type != 'check'" />
                        <field
              name="check_issue_date"
              invisible="document_type != 'check'"
            />
                        <field
              name="check_payment_date"
              invisible="document_type != 'check'"
            />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_collection_voucher" model="ir.actions.act_window">
        <field name="name">Payment Vouchers</field>
        <field name="res_model">collection.voucher</field>
        <field name="path">payment-vouchers</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_collection_voucher_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a payment voucher
            </p>
        </field>
    </record>

    <!-- Menus: Collections → Payment Vouchers -->
    <menuitem id="menu_collection_root" name="Collections" sequence="45" />
    <menuitem
    id="menu_collection_voucher"
    name="Payment Vouchers"
    parent="menu_collection_root"
    action="action_collection_voucher"
    sequence="10"
  />
</odoo>
