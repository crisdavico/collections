<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_collection_company_settings_form" model="ir.ui.view">
        <field name="name">collection.company.settings.form</field>
        <field name="model">collection.company.settings</field>
        <field name="arch" type="xml">
            <form
        string="Collection Settings"
        duplicate="false"
        delete="false"
        js_class="collection_company_settings"
      >
                <sheet>
                    <group>
                        <field
              name="company_id"
              readonly="1"
              options="{'no_open': True}"
            />
                    </group>
                    <notebook>
                        <page name="general" string="General">
                            <group>
                                <field name="auto_create_sheet" />
                                <field name="document_review_enabled" />
                                <field
                  name="allowed_document_type_ids"
                  widget="many2many_tags"
                  options="{'no_create': True}"
                />
                            </group>
                        </page>
                        <page name="sellers" string="Sellers">
                            <group>
                                <field
                  name="enabled_seller_ids"
                  widget="many2many_tags"
                  options="{'no_create': True, 'no_open': True}"
                />
                            </group>
                            <button
                name="action_import_enabled_sellers"
                type="object"
                string="Import Sellers"
                class="btn-secondary mb-3"
                invisible="not collection_connector_id"
              />
                            <field
                name="seller_binding_ids"
                invisible="not collection_connector_id"
                readonly="1"
              >
                                <list create="false" edit="false" delete="false">
                                    <field name="user_id" options="{'no_open': True}" />
                                    <field
                    name="commission_percent"
                    string="Commission %"
                  />
                                </list>
                            </field>
                        </page>
                        <page name="bank_accounts" string="Bank Accounts">
                            <button
                name="action_open_bank_accounts"
                type="object"
                string="Manage Bank Accounts"
                class="btn-secondary mb-3"
              />
                            <field name="bank_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="acc_number" />
                                    <field name="bank_id" />
                                </list>
                            </field>
                        </page>
                        <page name="integration" string="Integration">
                            <group>
                                <field
                  name="collection_connector_id"
                  options="{'no_create': True}"
                />
                            </group>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <button
                  name="action_open_connector_settings"
                  type="object"
                  string="Configure Connection"
                  class="btn-secondary"
                  invisible="not collection_connector_id"
                />
                                <button
                  name="action_test_connection"
                  type="object"
                  string="Test Connection"
                  class="btn-secondary"
                  invisible="not collection_connector_id"
                />
                                <button
                  name="action_manage_connectors"
                  type="object"
                  string="Manage Connectors and Mappings"
                  class="btn-link"
                />
                            </div>
                            <group string="Advanced" groups="base.group_system">
                                <field
                  name="collection_mcp_trusted_seller_header"
                  placeholder="X-Sender-Phone"
                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_collection_company_settings" model="ir.actions.act_window">
        <field name="name">Collection Settings</field>
        <field name="path">collection-settings</field>
        <field name="res_model">collection.company.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem
    id="menu_collection_config"
    name="Configuration"
    parent="menu_collection_root"
    action="action_collection_company_settings"
    sequence="100"
    groups="base.group_system,collection.group_collection_manager"
  />
    <record id="menu_collection_company_settings" model="ir.ui.menu">
        <field name="name">Company Collection Settings</field>
        <field name="parent_id" ref="menu_collection_config" />
        <field name="action" ref="action_collection_company_settings" />
        <field name="group_ids" eval="[(6, 0, [ref('group_collection_manager')])]" />
        <field name="active" eval="False" />
    </record>
    <record id="action_collection_company_banks" model="ir.actions.server">
        <field name="name">Company Bank Accounts</field>
        <field name="path">collection-bank-accounts</field>
        <field name="model_id" ref="model_collection_company_settings" />
        <field name="state">code</field>
        <field name="code">action = model.action_bank_accounts()</field>
    </record>
    <record id="menu_collection_company_banks" model="ir.ui.menu">
        <field name="name">Company Bank Accounts</field>
        <field name="parent_id" ref="menu_collection_config" />
        <field name="action" ref="action_collection_company_banks" />
        <field name="group_ids" eval="[(6, 0, [ref('group_collection_manager')])]" />
        <field name="active" eval="False" />
    </record>
</odoo>
