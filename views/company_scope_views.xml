<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_event_form_company" model="ir.ui.view">
        <field name="name">calendar.event.form.company</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <field name="location" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
    <record id="discuss_channel_form_company" model="ir.ui.view">
        <field name="name">discuss.channel.form.company</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <field name="group_public_id" position="before">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
</odoo>
