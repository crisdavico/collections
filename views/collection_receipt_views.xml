<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_collection_receipt_list" model="ir.ui.view">
        <field name="name">collection.receipt.list</field>
        <field name="model">collection.receipt</field>
        <field name="arch" type="xml">
            <list string="Collection Receipts">
                <field name="document_kind" />
                <field name="partner_id" />
                <field name="sheet_id" />
                <field name="state" />
                <field name="total_values" />
                <field name="total_applied" />
                <field name="amount_on_account" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_collection_receipt_search" model="ir.ui.view">
        <field name="name">collection.receipt.search</field>
        <field name="model">collection.receipt</field>
        <field name="arch" type="xml">
            <search string="Search Collection Receipts">
                <field name="document_kind" />
                <field name="partner_id" />
                <field name="sheet_id" />
                <field name="state" />
                <filter
          string="Draft"
          name="filter_draft"
          domain="[('state', '=', 'draft')]"
        />
                <filter
          string="Issued"
          name="filter_issued"
          domain="[('state', '=', 'issued')]"
        />
                <group>
                    <filter
            string="Status"
            name="group_state"
            context="{'group_by': 'state'}"
          />
                    <filter
            string="Kind"
            name="group_document_kind"
            context="{'group_by': 'document_kind'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="view_collection_receipt_form" model="ir.ui.view">
        <field name="name">collection.receipt.form</field>
        <field name="model">collection.receipt</field>
        <field name="arch" type="xml">
            <form string="Collection Receipt">
                <sheet>
                    <group>
                        <group>
                            <field name="allocation_id" />
                            <field name="document_kind" />
                            <field name="partner_id" />
                            <field name="sheet_id" />
                        </group>
                        <group>
                            <field name="state" readonly="1" />
                            <field name="total_values" />
                            <field name="total_applied" />
                            <field name="amount_on_account" />
                            <field name="currency_id" groups="base.group_no_one" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids">
                                <list>
                                    <field name="voucher_id" />
                                    <field name="amount" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Applied Debt">
                            <field name="line_ids" readonly="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="invoice_number" />
                                    <field name="due_date" />
                                    <field name="invoice_amount" />
                                    <field name="invoice_balance" />
                                    <field name="amount_applied" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_collection_receipt" model="ir.actions.act_window">
        <field name="name">Collection Receipts</field>
        <field name="res_model">collection.receipt</field>
        <field name="path">collection-receipts</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_receipt_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Collection receipts issued by the ERP
            </p>
        </field>
    </record>

    <menuitem
    id="menu_collection_receipt"
    name="Collection Receipts"
    parent="menu_collection_root"
    action="action_collection_receipt"
    sequence="40"
  />
</odoo>
