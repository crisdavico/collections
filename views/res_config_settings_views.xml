<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.collection</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
          data-string="Collections"
          string="Collections"
          name="collections"
          groups="base.group_system"
        >
                    <block title="Collection Work" name="collection_work">
                        <setting
              string="Enabled Sellers"
              help="Sellers allowed to register new collection work. An empty list means none."
              id="enabled_seller_ids_setting"
            >
                            <field name="enabled_seller_ids" widget="many2many_tags" />
                            <button
                name="action_import_enabled_sellers"
                type="object"
                string="Import"
                class="btn-link"
                invisible="not collection_connector_id"
                groups="base.group_system"
              />
                            <field
                name="seller_binding_ids"
                readonly="1"
                invisible="not collection_connector_id"
              >
                                <list>
                                    <field name="user_id" readonly="1" />
                                    <field
                    name="commission_percent"
                    string="Commission %"
                    readonly="1"
                  />
                                </list>
                            </field>
                        </setting>
                        <setting
              string="Auto-create collection sheet"
              help="When enabled, new vouchers with a seller and no sheet are auto-assigned."
              id="auto_create_sheet_setting"
            >
                            <field name="auto_create_sheet" />
                        </setting>
                        <setting
              string="Allowed document types"
              help="Document types allowed for new collection work."
              id="allowed_document_type_ids_setting"
            >
                            <field
                name="allowed_document_type_ids"
                widget="many2many_tags"
              />
                        </setting>
                        <setting
              string="Collection connector"
              help="Active seller source for this company. Leave empty to disable listing."
              id="collection_connector_id_setting"
            >
                            <field name="collection_connector_id" />
                        </setting>
                        <setting
              string="Company bank accounts"
              help="The company's own bank accounts. Used to match transfer and cash deposit destinations."
              id="bank_ids_setting"
            >
                            <field name="bank_ids">
                                <list editable="bottom">
                                    <field name="acc_number" />
                                    <field name="bank_id" />
                                </list>
                            </field>
                        </setting>
                    </block>
                    <block title="Document Review" name="document_review">
                        <setting
              string="Document Review"
              help="Enable Document Review for this company"
              id="document_review_enabled_setting"
            >
                            <field name="document_review_enabled" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_collection_config_settings" model="ir.actions.act_window">
        <field name="name">Collection Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'collections', 'bin_size': False}</field>
    </record>

    <menuitem
    id="menu_collection_config"
    name="Configuration"
    parent="menu_collection_root"
    sequence="100"
    groups="base.group_system,collection.group_collection_manager"
  />
    <menuitem
    id="menu_collection_settings"
    name="Collection Settings"
    parent="menu_collection_config"
    action="action_collection_config_settings"
    sequence="0"
    groups="base.group_system"
  />
</odoo>
