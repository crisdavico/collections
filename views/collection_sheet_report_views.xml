<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_collection_allocation_form_document_kind"
        model="ir.ui.view"
    >
        <field name="name">collection.allocation.form.document.kind</field>
        <field name="model">collection.allocation</field>
        <field name="inherit_id" ref="collection.view_collection_allocation_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='invoice_number']"
                position="before"
            >
                <field name="document_kind" />
            </xpath>
        </field>
    </record>
</odoo>
