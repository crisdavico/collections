<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_collection_connector_list" model="ir.ui.view">
        <field name="name">collection.connector.list</field>
        <field name="model">collection.connector</field>
        <field name="arch" type="xml">
            <list string="Connectors">
                <field name="name" />
                <field name="type" />
                <field name="company_id" optional="hide" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_collection_connector_form" model="ir.ui.view">
        <field name="name">collection.connector.form</field>
        <field name="model">collection.connector</field>
        <field name="arch" type="xml">
            <form string="Connector">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="type" />
                        </group>
                        <group>
                            <field name="company_id" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Seller Bindings">
                            <field name="seller_binding_ids">
                                <list>
                                    <field name="external_seller_id" readonly="1" />
                                    <field name="user_id" readonly="1" />
                                    <field name="commission_percent" readonly="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Customer Bindings">
                            <field name="customer_binding_ids">
                                <list>
                                    <field name="external_customer_id" />
                                    <field name="identification" />
                                    <field name="partner_id" />
                                    <field name="customer_code" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_collection_connector_search" model="ir.ui.view">
        <field name="name">collection.connector.search</field>
        <field name="model">collection.connector</field>
        <field name="arch" type="xml">
            <search string="Search Connectors">
                <field name="name" />
                <field name="type" />
                <field name="company_id" />
                <filter
          string="Archived"
          name="inactive"
          domain="[('active', '=', False)]"
        />
            </search>
        </field>
    </record>

    <record id="action_collection_connector" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">collection.connector</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="menu_collection_connector" model="ir.ui.menu">
        <field name="name">Connectors</field>
        <field name="parent_id" ref="menu_collection_config" />
        <field name="action" ref="action_collection_connector" />
        <field
      name="group_ids"
      eval="[(6, 0, [ref('base.group_system'), ref('group_collection_manager')])]"
    />
        <field name="active" eval="False" />
    </record>
</odoo>
