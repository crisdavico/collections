<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="seq_collection_voucher" model="ir.sequence">
        <field name="name">Payment Voucher</field>
        <field name="code">collection.voucher</field>
        <field name="prefix">COL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="seq_collection_sheet" model="ir.sequence">
        <field name="name">Collection Sheet</field>
        <field name="code">collection.sheet</field>
        <field name="prefix">CS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="seq_collection_allocation" model="ir.sequence">
        <field name="name">Collection Allocation</field>
        <field name="code">collection.allocation</field>
        <field name="prefix">CA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" ref="base.main_company" />
    </record>
</odoo>
