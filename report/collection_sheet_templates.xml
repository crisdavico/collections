<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_collection_sheet">
        <t t-call="web.html_container">
            <t t-foreach="payloads" t-as="payload">
                <t t-set="o" t-value="payload['sheet']" />
                <t t-call="collection.report_collection_sheet_document" />
            </t>
        </t>
    </template>

    <template id="report_collection_sheet_document">
        <!-- No company header: web.html_container (wrapper) already provides the
             HTML shell, so only the `.article` wrapper basic_layout adds is kept.
             The `.footer` sibling is lifted by ir.actions.report into the
             wkhtmltopdf footer, which fills the page / topage spans. -->
        <t
      t-set="money"
      t-value="{'widget': 'monetary', 'display_currency': payload['currency']}"
    />
        <div
      class="article"
      t-att-data-oe-model="o and o._name"
      t-att-data-oe-id="o and o.id"
    >
            <div class="page">
                <style>
                    .article { padding-top: 0 !important; margin-top: 0 !important; }
                    .o_cs_title {
                        font-size: 15px; font-weight: bold; margin: 0 0 5px;
                        color: #1f4e79; line-height: 1.2;
                    }
                    .o_cs_sheet { font-size: 12px; color: #1f4e79; margin: 0; }
                    .o_cs_sheet h3 {
                        background: #1f4e79; color: #fff;
                        padding: 5px 7px; font-size: 14px;
                        margin: 13px 0 4px; line-height: 1.25;
                    }
                    .o_cs_sheet h4 {
                        font-size: 12px; margin: 9px 0 4px; font-weight: bold;
                        line-height: 1.2;
                    }
                    .o_cs_sheet table {
                        width: 100%; border-collapse: collapse;
                        table-layout: fixed; margin: 0;
                    }
                    .o_cs_sheet thead { display: table-header-group; }
                    .o_cs_sheet tr { page-break-inside: avoid; }
                    .o_cs_sheet th, .o_cs_sheet td {
                        border: 1px solid #8ea9db; padding: 8px 6px;
                        line-height: 1.35; vertical-align: top;
                        overflow-wrap: break-word; word-wrap: break-word;
                    }
                    /* Atomic values must never be split across two lines; their
                       columns are sized to fit. Headers and free text wrap. */
                    .o_cs_sheet .o_cs_num,
                    .o_cs_sheet .o_cs_date,
                    .o_cs_sheet tbody td:first-child { white-space: nowrap; }
                    .o_cs_sheet th {
                        background: #dbe5f1; text-align: left;
                        overflow-wrap: normal; word-wrap: normal;
                    }
                    .o_cs_sheet .o_cs_sub { background: #ededed; font-weight: bold; }
                    .o_cs_sheet .o_cs_total td {
                        background: #1f4e79; color: #fff; font-weight: bold;
                    }
                    .o_cs_sheet .o_cs_num, .o_cs_sheet .o_cs_sub td,
                    .o_cs_sheet .o_cs_total td { text-align: right; }
                    .o_cs_sheet .o_cs_date { text-align: center; }
                    .o_cs_sheet .o_cs_hint {
                        font-style: italic; font-size: 10px; color: #808080;
                    }
                    .o_cs_sheet .o_cs_fields th { width: 19%; text-align: right; }
                    .o_cs_sheet .o_cs_fields td { width: 14.33%; text-align: left; }
                    .o_cs_sheet .o_cs_totals th { width: 25%; text-align: right; }
                    .o_cs_sheet .o_cs_totals td { width: 25%; }
                    .o_cs_sheet .o_cs_verdict { margin-bottom: 4px; }
                    .o_cs_sheet .o_cs_verdict th { text-align: center; width: 33.33%; }
                    .o_cs_sheet .o_cs_verdict td {
                        text-align: center; font-size: 16px; font-weight: bold;
                        white-space: nowrap;
                    }
                    .o_cs_customers th:nth-child(1), .o_cs_customers td:nth-child(1) { width: 7%; }
                    .o_cs_customers th:nth-child(2), .o_cs_customers td:nth-child(2) { width: 25%; }
                    .o_cs_customers th:nth-child(n+3), .o_cs_customers td:nth-child(n+3) { width: 17%; }
                    .o_cs_docs th:nth-child(1), .o_cs_docs td:nth-child(1) { width: 7%; }
                    .o_cs_docs th:nth-child(2), .o_cs_docs td:nth-child(2) { width: 20%; }
                    .o_cs_docs th:nth-child(3), .o_cs_docs td:nth-child(3) { width: 16%; }
                    .o_cs_docs th:nth-child(4), .o_cs_docs td:nth-child(4) { width: 11%; }
                    .o_cs_docs th:nth-child(n+5), .o_cs_docs td:nth-child(n+5) { width: 15.33%; }
                    .o_cs_checks th:nth-child(1), .o_cs_checks td:nth-child(1) { width: 7%; }
                    .o_cs_checks th:nth-child(2), .o_cs_checks td:nth-child(2) { width: 17%; }
                    .o_cs_checks th:nth-child(3), .o_cs_checks td:nth-child(3) { width: 11%; }
                    .o_cs_checks th:nth-child(4), .o_cs_checks td:nth-child(4) { width: 12%; }
                    .o_cs_checks th:nth-child(5), .o_cs_checks td:nth-child(5) { width: 13%; }
                    .o_cs_checks th:nth-child(6), .o_cs_checks td:nth-child(6) { width: 10%; }
                    .o_cs_checks th:nth-child(7), .o_cs_checks td:nth-child(7) { width: 11%; }
                    .o_cs_checks th:nth-child(8), .o_cs_checks td:nth-child(8) { width: 19%; }
                    .o_cs_vouchers th:nth-child(1), .o_cs_vouchers td:nth-child(1) { width: 7%; }
                    .o_cs_vouchers th:nth-child(2), .o_cs_vouchers td:nth-child(2) { width: 35%; }
                    .o_cs_vouchers th:nth-child(3), .o_cs_vouchers td:nth-child(3) { width: 12%; }
                    .o_cs_vouchers th:nth-child(4), .o_cs_vouchers td:nth-child(4) { width: 16%; }
                    .o_cs_vouchers th:nth-child(5), .o_cs_vouchers td:nth-child(5) { width: 30%; }
                    /* Grand totals sit in their own one-row tables; widths line the
                       amounts up with the last columns of the blocks above. */
                    .o_cs_grand_applied td:nth-child(1) { width: 69.34%; }
                    .o_cs_grand_applied td:nth-child(n+2) { width: 15.33%; }
                    .o_cs_grand_collected td:nth-child(1) { width: 81%; }
                    .o_cs_grand_collected td:nth-child(2) { width: 19%; }
                    .o_cs_lines td:nth-child(1) { width: 32%; }
                    .o_cs_lines td:nth-child(2) { width: 48%; }
                    .o_cs_lines td:nth-child(3) { width: 20%; }
                    .o_cs_sheet .o_cs_lines .o_cs_strong td { background: #dbe5f1; font-weight: bold; }
                    .o_cs_banner_balanced { background: #c6efce; padding: 7px 7px; margin-top: 6px; }
                    .o_cs_banner_in_favor { background: #fff2cc; padding: 7px 7px; margin-top: 6px; }
                    .o_cs_banner_outstanding { background: #ffc7ce; padding: 7px 7px; margin-top: 6px; }
                    .o_cs_mismatch { background: #fff2cc; padding: 7px 7px; margin-top: 6px; }
                    .o_cs_signatures { margin-top: 36px; page-break-inside: avoid; }
                    .o_cs_sheet .o_cs_signatures td {
                        border: none; width: 50%; padding: 40px 24px 0;
                        text-align: center;
                    }
                    .o_cs_signature_line { border-top: 1px solid #1f4e79; padding-top: 4px; }
                </style>
                <h2 class="o_cs_title">Planilla de Cobranza — <t
            t-out="payload['reference']"
          /></h2>
                <div class="o_cs_sheet">
                    <!-- The answer first: what was due, what was handed in. -->
                    <table class="o_cs_verdict">
                        <tr>
                            <th>A entregar por el Vendedor</th>
                            <th>Entregado por el Vendedor</th>
                            <th>Diferencia</th>
                        </tr>
                        <tr>
                            <td>
                                <span
                  t-out="payload['recon']['net_due']"
                  t-options="money"
                />
                            </td>
                            <td>
                                <span
                  t-out="payload['recon']['tendered']"
                  t-options="money"
                />
                            </td>
                            <td>
                                <span
                  t-out="payload['recon']['difference']"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>
                    <div
            t-attf-class="o_cs_banner o_cs_banner_#{payload['recon']['status']}"
          >
                        <strong t-out="payload['recon']['status_message']" />
                    </div>
                    <div t-if="payload['mismatch']" class="o_cs_mismatch">
                        Atención: lo cobrado según las asignaciones (<span
              t-out="payload['allocated_collected']"
              t-options="money"
            />) no coincide con el total de comprobantes de la planilla (<span
              t-out="payload['collected_total']"
              t-options="money"
            />). Diferencia: <span
              t-out="abs(payload['collected_total'] - payload['allocated_collected'])"
              t-options="money"
            />.
                    </div>

                    <h3>Datos de la Planilla</h3>
                    <table class="o_cs_header_info o_cs_fields">
                        <tr>
                            <th>Referencia</th>
                            <td t-out="payload['reference']" />
                            <th>Estado</th>
                            <td t-out="payload['state_label']" />
                            <th>Vendedor</th>
                            <td t-out="payload['seller_name']" />
                        </tr>
                        <tr>
                            <th>Desde</th>
                            <td class="o_cs_date">
                                <t
                  t-if="payload['date_from']"
                  t-out="payload['date_from'].strftime('%d/%m/%Y')"
                />
                            </td>
                            <th>Hasta</th>
                            <td class="o_cs_date">
                                <t
                  t-if="payload['date_to']"
                  t-out="payload['date_to'].strftime('%d/%m/%Y')"
                />
                            </td>
                            <th>Moneda</th>
                            <td t-out="payload['currency_name']" />
                        </tr>
                        <tr>
                            <th>Cantidad de Clientes</th>
                            <td t-out="payload['customer_count']" />
                            <th>Cantidad de Comprobantes</th>
                            <td t-out="payload['voucher_count']" />
                            <th>% Comisión Vendedor</th>
                            <td t-out="('%g' % payload['commission_percent']) + ' %'" />
                        </tr>
                    </table>

                    <h3>Totales</h3>
                    <table class="o_cs_totals">
                        <tr>
                            <th>Total Cobrado</th>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['collected_total']"
                  t-options="money"
                />
                            </td>
                            <th>Total Aplicado</th>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['applied_total']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <th>Deuda sin cobrar</th>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['customer_totals']['residual']"
                  t-options="money"
                />
                            </td>
                            <th>Total Comisión Devengada</th>
                            <td class="o_cs_num">
                                <span
                  t-out="sum(block['subtotal_commission'] for block in payload['document_blocks'])"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>

                    <h3>Clientes</h3>
                    <table class="o_cs_customers">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cliente</th>
                                <th class="o_cs_num">Saldo Total</th>
                                <th class="o_cs_num">Cobrado</th>
                                <th class="o_cs_num">Aplicado</th>
                                <th class="o_cs_num">Deuda sin cobrar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="payload['customers']" t-as="row">
                                <td t-out="row['code']" />
                                <td t-out="row['name']" />
                                <td class="o_cs_num">
                                    <span t-out="row['debt']" t-options="money" />
                                </td>
                                <td class="o_cs_num">
                                    <span t-out="row['collected']" t-options="money" />
                                </td>
                                <td class="o_cs_num">
                                    <span t-out="row['applied']" t-options="money" />
                                </td>
                                <td class="o_cs_num">
                                    <span t-out="row['residual']" t-options="money" />
                                </td>
                            </tr>
                            <tr class="o_cs_customers_total o_cs_total">
                                <td colspan="2">Total</td>
                                <td class="o_cs_num">
                                    <span
                    t-out="payload['customer_totals']['debt']"
                    t-options="money"
                  />
                                </td>
                                <td class="o_cs_num">
                                    <span
                    t-out="payload['customer_totals']['collected']"
                    t-options="money"
                  />
                                </td>
                                <td class="o_cs_num">
                                    <span
                    t-out="payload['customer_totals']['applied']"
                    t-options="money"
                  />
                                </td>
                                <td class="o_cs_num">
                                    <span
                    t-out="payload['customer_totals']['residual']"
                    t-options="money"
                  />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Documentos Aplicados</h3>
                    <t t-foreach="payload['document_blocks']" t-as="block">
                        <h4 t-if="block['kind'] == 'invoice'">Facturas</h4>
                        <h4 t-else="">Presupuestos</h4>
                        <table class="o_cs_docs">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Documento</th>
                                    <th>Vencimiento</th>
                                    <th class="o_cs_num">Saldo</th>
                                    <th class="o_cs_num">Aplicado</th>
                                    <th class="o_cs_num">Comisión</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td t-out="row['code']" />
                                    <td t-out="row['name']" />
                                    <td t-out="row['invoice_number']" />
                                    <td class="o_cs_date">
                                        <t
                      t-if="row['due_date']"
                      t-out="row['due_date'].strftime('%d/%m/%Y')"
                    />
                                    </td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="row['invoice_balance']"
                      t-options="money"
                    />
                                    </td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="row['amount_applied']"
                      t-options="money"
                    />
                                    </td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="row['commission']"
                      t-options="money"
                    />
                                    </td>
                                </tr>
                                <tr class="o_cs_sub">
                                    <td colspan="5">Subtotal</td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="block['subtotal_applied']"
                      t-options="money"
                    />
                                    </td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="block['subtotal_commission']"
                      t-options="money"
                    />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <table t-if="payload['document_blocks']" class="o_cs_grand">
                        <tr class="o_cs_grand_applied o_cs_total">
                            <td>Total Aplicado</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['applied_total']"
                  t-options="money"
                />
                            </td>
                            <td class="o_cs_num">
                                <span
                  t-out="sum(block['subtotal_commission'] for block in payload['document_blocks'])"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>

                    <h3>Comprobantes</h3>
                    <t t-foreach="payload['voucher_blocks']" t-as="block">
                        <h4 t-out="block['label']" />
                        <table class="o_cs_checks" t-if="block['code'] == 'check'">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Fecha de Emisión</th>
                                    <th>Nº Cheque</th>
                                    <th>Banco</th>
                                    <th>Tipo</th>
                                    <th>Fecha de Pago</th>
                                    <th class="o_cs_num">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td t-out="row['code']" />
                                    <td t-out="row['name']" />
                                    <td class="o_cs_date">
                                        <t
                      t-if="row['date']"
                      t-out="row['date'].strftime('%d/%m/%Y')"
                    />
                                    </td>
                                    <td t-out="row['number']" />
                                    <td t-out="row['check_bank']" />
                                    <td t-out="row['check_type']" />
                                    <td class="o_cs_date">
                                        <t
                      t-if="row['check_payment_date']"
                      t-out="row['check_payment_date'].strftime('%d/%m/%Y')"
                    />
                                    </td>
                                    <td class="o_cs_num">
                                        <span t-out="row['amount']" t-options="money" />
                                    </td>
                                </tr>
                                <tr class="o_cs_sub">
                                    <td colspan="7">Subtotal</td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="block['subtotal']"
                      t-options="money"
                    />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="o_cs_vouchers" t-else="">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Nº Comprobante</th>
                                    <th class="o_cs_num">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td t-out="row['code']" />
                                    <td t-out="row['name']" />
                                    <td class="o_cs_date">
                                        <t
                      t-if="row['date']"
                      t-out="row['date'].strftime('%d/%m/%Y')"
                    />
                                    </td>
                                    <td t-out="row['number']" />
                                    <td class="o_cs_num">
                                        <span t-out="row['amount']" t-options="money" />
                                    </td>
                                </tr>
                                <tr class="o_cs_sub">
                                    <td colspan="4">Subtotal</td>
                                    <td class="o_cs_num">
                                        <span
                      t-out="block['subtotal']"
                      t-options="money"
                    />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <table t-if="payload['voucher_blocks']" class="o_cs_grand">
                        <tr class="o_cs_grand_collected o_cs_total">
                            <td>Total Cobrado</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['collected_total']"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>

                    <h3>Conciliación del Vendedor</h3>
                    <table class="o_cs_recon o_cs_lines">
                        <tr>
                            <td>Total Cobrado</td>
                            <td class="o_cs_hint">lo que pagaron los clientes</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['collected']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>(−) Comisión Retenida por el Vendedor</td>
                            <td
                class="o_cs_hint"
              >la que descuenta en el acto; 0 si se liquida aparte</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['withheld']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr class="o_cs_strong">
                            <td>(=) A entregar por el Vendedor</td>
                            <td
                class="o_cs_hint"
              >lo que tenía que entregar a la empresa</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['net_due']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Entregado por el Vendedor</td>
                            <td class="o_cs_hint">lo que entregó; detalle abajo</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['tendered']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr class="o_cs_strong">
                            <td>(=) Diferencia</td>
                            <td class="o_cs_hint">Entregado − A entregar</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['difference']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Comisión a Pagar al Vendedor</td>
                            <td
                class="o_cs_hint"
              >Comisión Devengada − Comisión Retenida</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['recon']['commission_owed']"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>
                    <h4>Composición de lo Entregado</h4>
                    <table class="o_cs_tendered o_cs_lines">
                        <tr>
                            <td>Efectivo en Caja</td>
                            <td
                class="o_cs_hint"
              >efectivo cobrado, menos lo que depositó el vendedor y la comisión retenida</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['cash']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Depósitos de clientes</td>
                            <td
                class="o_cs_hint"
              >el cliente depositó en la cuenta de la empresa</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['deposits']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Cheques</td>
                            <td />
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['checks']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Transferencias</td>
                            <td />
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['transfers']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Echeqs</td>
                            <td />
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['echecks']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Retenciones</td>
                            <td
                class="o_cs_hint"
              >certificados de retención del cliente</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['retentions']"
                  t-options="money"
                />
                            </td>
                        </tr>
                        <tr>
                            <td>Depósitos del vendedor</td>
                            <td
                class="o_cs_hint"
              >el vendedor depositó en el banco el efectivo cobrado</td>
                            <td class="o_cs_num">
                                <span
                  t-out="payload['tendered']['seller_deposits']"
                  t-options="money"
                />
                            </td>
                        </tr>
                    </table>

                    <table class="o_cs_signatures">
                        <tr>
                            <td>
                                <div
                  class="o_cs_signature_line"
                >Firma del vendedor</div>
                            </td>
                            <td>
                                <div
                  class="o_cs_signature_line"
                >Recibió — firma y aclaración</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="footer o_cs_footer">
            <div
        style="font-size: 10px; color: #808080; border-top: 1px solid #8ea9db; padding-top: 3px;"
      >
                <span t-out="payload['reference']" /> · Impreso el <t
          t-out="payload['printed_on'].strftime('%d/%m/%Y')"
        />
                <span style="float: right;">Página <span class="page" /> de <span
            class="topage"
          /></span>
            </div>
        </div>
    </template>
</odoo>
